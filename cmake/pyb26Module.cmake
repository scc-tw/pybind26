include_guard(GLOBAL)

function(pyb26_configure_extension target)
  _pyb26_configure_compile(${target} ${ARGN})
endfunction()

function(pyb26_add_module target)
  cmake_parse_arguments(PARSE_ARGV 1 module "NUMPY;PRIVATE_RUNTIME" "" "SOURCES")
  if(module_UNPARSED_ARGUMENTS OR module_KEYWORDS_MISSING_VALUES OR NOT module_SOURCES)
    message(FATAL_ERROR "pyb26_add_module(NAME SOURCES source.cpp... [NUMPY] [PRIVATE_RUNTIME])")
  endif()
  if(PYB26_LIMITED_API OR DEFINED Py_LIMITED_API)
    message(FATAL_ERROR "pyb26 supports the full CPython ABI only; abi3/abi3t are unsupported")
  endif()
  set(python_components Interpreter Development.Module)
  if(module_NUMPY)
    list(APPEND python_components NumPy)
  endif()
  find_package(Python 3.14 REQUIRED COMPONENTS ${python_components} GLOBAL)
  find_package(Threads REQUIRED GLOBAL)
  _pyb26_check_python_identity()
  get_target_property(runtime_sources pyb26::headers _PYB26_RUNTIME_SOURCES)
  get_target_property(numpy_source pyb26::headers _PYB26_NUMPY_SOURCE)
  Python_add_library(${target} MODULE WITH_SOABI ${module_SOURCES})
  target_link_libraries(${target} PRIVATE pyb26::headers Threads::Threads)
  if(module_PRIVATE_RUNTIME)
    target_sources(${target} PRIVATE ${runtime_sources})
  else()
    _pyb26_get_runtime(runtime)
    target_link_libraries(${target} PRIVATE ${runtime})
  endif()
  if(module_NUMPY)
    target_sources(${target} PRIVATE "${numpy_source}")
    target_link_libraries(${target} PRIVATE Python::NumPy)
  endif()
  pyb26_configure_extension(${target})
endfunction()
