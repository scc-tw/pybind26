include_guard(GLOBAL)

function(_pyb26_check_python_identity)
  set(identity "")
  foreach(variable IN ITEMS Python_EXECUTABLE Python_VERSION Python_SOABI Python_INCLUDE_DIRS)
    string(APPEND identity "${variable}=[${${variable}}]\n")
  endforeach()
  foreach(property IN ITEMS INTERFACE_INCLUDE_DIRECTORIES INTERFACE_COMPILE_DEFINITIONS
      INTERFACE_COMPILE_OPTIONS INTERFACE_LINK_LIBRARIES INTERFACE_LINK_OPTIONS)
    get_target_property(value Python::Module ${property})
    string(APPEND identity "Python::Module.${property}=[${value}]\n")
  endforeach()
  get_target_property(previous pyb26::headers _PYB26_PYTHON_IDENTITY)
  if(previous AND NOT previous STREQUAL identity)
    message(FATAL_ERROR "pyb26 Python ABI changed within one build tree; use separate GIL/FT or Python-version build trees")
  endif()
  get_target_property(resource_target pyb26::headers ALIASED_TARGET)
  if(NOT resource_target)
    set(resource_target pyb26::headers)
  endif()
  set_property(TARGET ${resource_target} PROPERTY _PYB26_PYTHON_IDENTITY "${identity}")
endfunction()

function(_pyb26_get_runtime result)
  set(contract "")
  foreach(property IN ITEMS COMPILE_DEFINITIONS COMPILE_OPTIONS INCLUDE_DIRECTORIES)
    get_directory_property(value ${property})
    string(APPEND contract "directory.${property}=[${value}]\n")
  endforeach()
  set(variables CMAKE_CXX_COMPILER CMAKE_CXX_COMPILER_ID CMAKE_CXX_COMPILER_VERSION
    CMAKE_CXX_COMPILER_TARGET CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN
    CMAKE_SYSROOT CMAKE_OSX_SYSROOT CMAKE_OSX_ARCHITECTURES CMAKE_OSX_DEPLOYMENT_TARGET
    CMAKE_CXX_FLAGS CMAKE_CXX_STANDARD CMAKE_CXX_STANDARD_REQUIRED
    CMAKE_INTERPROCEDURAL_OPTIMIZATION CMAKE_CXX_COMPILER_LAUNCHER)
  set(configurations Debug Release RelWithDebInfo MinSizeRel ${CMAKE_CONFIGURATION_TYPES} ${CMAKE_BUILD_TYPE})
  list(REMOVE_DUPLICATES configurations)
  foreach(configuration IN LISTS configurations)
    string(TOUPPER "${configuration}" configuration)
    list(APPEND variables CMAKE_CXX_FLAGS_${configuration}
      CMAKE_INTERPROCEDURAL_OPTIMIZATION_${configuration})
  endforeach()
  foreach(variable IN LISTS variables)
    string(APPEND contract "${variable}=[${${variable}}]\n")
  endforeach()
  set(runtime _pyb26_runtime)
  if(TARGET ${runtime})
    get_target_property(previous ${runtime} _PYB26_COMPILE_CONTRACT)
    if(NOT previous STREQUAL contract)
      message(FATAL_ERROR "pyb26 shared runtime compile settings differ between module directories; use uniform directory settings or pyb26_add_module(... PRIVATE_RUNTIME SOURCES ...)")
    endif()
  else()
    get_target_property(runtime_sources pyb26::headers _PYB26_RUNTIME_SOURCES)
    add_library(${runtime} STATIC EXCLUDE_FROM_ALL ${runtime_sources})
    target_link_libraries(${runtime} PRIVATE pyb26::headers Python::Module Threads::Threads)
    _pyb26_configure_compile(${runtime})
    set_target_properties(${runtime} PROPERTIES EXPORT_COMPILE_COMMANDS ON)
    set_property(TARGET ${runtime} PROPERTY _PYB26_COMPILE_CONTRACT "${contract}")
  endif()
  set(${result} "${runtime}" PARENT_SCOPE)
endfunction()

